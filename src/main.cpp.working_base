#include <Arduino.h>
#include <Wire.h>
#include <Adafruit_GFX.h>
#include <Adafruit_SSD1306.h>
// ============================================================================
// SIGNBRIDGE - 5 FLEX SENSORS + LIGHTWEIGHT MPU6050 + OLED DASHBOARD
// ============================================================================
// Optimized embedded firmware:
// - Direct I2C driver for MPU6050 (saves ~12KB flash and >300 bytes RAM!)
// - Plenty of free RAM for SSD1306 OLED malloc (screen lights up instantly!)
// - Fast 400kHz I2C for snappy, lag-free visual response
// - Full 5-finger gauges + Pitch & Roll wrist orientation + Emergency Shake
// ============================================================================
// ---------------------- PIN DEFINITIONS -------------------------------------
// I2C Bus (Shared by SSD1306 OLED & MPU6050):
// A4 = SDA (Connect BOTH OLED SDA and MPU6050 SDA here)
// A5 = SCL (Connect BOTH OLED SCL and MPU6050 SCL here)
// VCC = 5V Rail, GND = GND Rail
// 5 Flex Sensors:
#define NUM_FLEX 5
const uint8_t FLEX_PINS[NUM_FLEX] = {A0, A1, A2, 2, A3};
// A0: Thumb  (Analog)
// A1: Index  (Analog)
// A2: Middle (Analog)
// D2: Ring   (Digital RC timing)
// A3: Pinky  (Analog)
const bool IS_ANALOG[NUM_FLEX] = {true, true, true, false, true};
const char FINGER_INITIALS[NUM_FLEX] = {'T', 'I', 'M', 'R', 'P'};
#define LED_PIN LED_BUILTIN
// ---------------------- AUDIO & SPEECH HARDWARE ------------------------------
// Cycle-Accurate 9600 Baud UART on Pins 10 (PB2) & 11 (PB3)
// Direct hardware port registers + atomic timing for 100% baud accuracy!
#define BUZZER_PIN 3
uint8_t dfPlayerVolume = 30; // Safe 23/30 prevents 5V brownout (Set to MAX 30 for clear, loud voice!)
void dfplayer_send_byte(uint8_t b) {
  // 9600.0 baud = exactly 104.16 microseconds per bit
  // Pull both Pin 10 (PB2) and Pin 11 (PB3) so either pin connection works!
  noInterrupts();

  // Start bit: pull both Pin 10 (PB2) and Pin 11 (PB3) LOW
  PORTB &= ~((1 << PB2) | (1 << PB3));
  delayMicroseconds(104);

  // 8 Data bits (LSB first)
  for (uint8_t mask = 1; mask != 0; mask <<= 1) {
    if (b & mask) {
      PORTB |= ((1 << PB2) | (1 << PB3));
    } else {
      PORTB &= ~((1 << PB2) | (1 << PB3));
    }
    delayMicroseconds(104);
  }

  // Stop bit: pull both pins HIGH
  PORTB |= ((1 << PB2) | (1 << PB3));
  delayMicroseconds(104);

  interrupts();
}

void dfplayer_send_cmd(uint8_t cmd, uint16_t arg) {
  uint16_t checksum = 0 - (0xFF + 0x06 + cmd + 0x00 + (arg >> 8) + (arg & 0xFF));
  uint8_t packet[10] = {
    0x7E,           // Start byte
    0xFF,           // Version
    0x06,           // Length
    cmd,            // Command
    0x00,           // Feedback (0 = no ACK required)
    (uint8_t)(arg >> 8),   // Param High
    (uint8_t)(arg & 0xFF), // Param Low
    (uint8_t)(checksum >> 8),
    (uint8_t)(checksum & 0xFF),
    0xEF            // End byte
  };

  for (uint8_t i = 0; i < 10; i++) {
    dfplayer_send_byte(packet[i]);
  }
}

void playVoiceTrack(uint8_t track) {
  // Direct single play command 0x03 (universal DFPlayer track play)
  dfplayer_send_cmd(0x03, track);
}
// ---------------------- DISPLAY CONFIGURATION --------------------------------
#define SCREEN_WIDTH 128
#define SCREEN_HEIGHT 64
#define OLED_RESET -1
Adafruit_SSD1306 display(SCREEN_WIDTH, SCREEN_HEIGHT, &Wire, OLED_RESET, 100000UL, 100000UL);
bool displayAvailable = false;
// ---------------------- MPU6050 CONFIGURATION --------------------------------
uint8_t mpuAddress = 0x68;
bool mpuAvailable = false;
// ---------------------- SENSOR & CALIBRATION DATA ---------------------------
struct FlexSensor {

  uint16_t raw;

  uint16_t baseline;    // Resting flat baseline ADC

  uint16_t minVal;      // Calibrated / auto-tracked straight value

  uint16_t maxVal;      // Calibrated / auto-tracked bent value

  uint8_t  bendPercent; // 0 - 100%

  bool     isBent;

  bool     inverted;    // True if bent ADC < straight ADC
};
FlexSensor flexSensors[NUM_FLEX];
#define BEND_THRESHOLD_PERCENT 50
// ---------------------- MOTION & ORIENTATION DATA ---------------------------
struct MotionData {

  float ax, ay, az;

  float gx, gy, gz;

  float pitch;        // -90 to +90 degrees

  float roll;         // -180 to +180 degrees

  float dynamicAccel; // G-force beyond Earth gravity

  float gyroEnergy;   // Rotational speed

  bool  isMoving;     // Dynamic hand shake / wave
};
MotionData motion;
enum WristPose {

  POSE_FLAT,

  POSE_UP,

  POSE_DOWN,

  POSE_TILT_LEFT,

  POSE_TILT_RIGHT,

  POSE_PALM_UP
};
WristPose currentPose = POSE_FLAT;
// ---------------------- GESTURE DEFINITIONS ---------------------------------
enum GestureId {

  GESTURE_NONE = 0,

  GESTURE_NEED_HELP,   // 1: Fist -> "I Need Help"

  GESTURE_WANT_WATER,  // 2: Pointing -> "Water"

  GESTURE_AM_OKAY,     // 3: Open flat hand -> "I'm Okay"

  GESTURE_THANK_YOU,   // 4: Thumbs up -> "Thank You"

  GESTURE_PEACE,       // 5: Peace sign -> "Peace"

  GESTURE_LOVE,        // 6: ILY sign -> "I Love You"

  GESTURE_CALL_DOCTOR  // 7: Rapid hand wave / vigorous shake -> "Doctor!"
};
GestureId currentGesture = GESTURE_NONE;
GestureId lastTriggeredGesture = GESTURE_NONE;
unsigned long gestureStartTime = 0;
unsigned long lastTriggerTime = 0;
const unsigned long GESTURE_HOLD_DURATION_MS = 250; // Snappy 250ms hold verification
const unsigned long TRIGGER_COOLDOWN_MS = 2500;     // 2.5s cooldown between triggers
// ---------------------- OPERATING MODES -------------------------------------
enum OutputMode {

  MODE_PLOTTER_RAW,  // Live graph of Raw ADC (0-1023)

  MODE_PLOTTER_PCT,  // Live graph of Bend % (0-100%)

  MODE_DIAGNOSTIC,   // Live raw ADC voltages & IMU text

  MODE_NORMAL        // Clean text mode
};
OutputMode currentMode = MODE_DIAGNOSTIC;
// ---------------------- FORWARD DECLARATIONS --------------------------------
uint16_t readDigitalRC();
void readFlexSensors();
bool initMPU6050();
void readMPU6050();
void classifyOrientation();
void detectGesture();
void triggerGestureAudio(GestureId g);
void updateDisplay();
void printSerialOutput();
void handleSerialCommands();
void runAutoCalibration();
void calibrateFlatBaseline();
void recoverI2CBus();
void scanI2C();
void sendOledRecoveryCommands();
void refreshOLED(uint8_t colOffset = 2);
uint8_t oledColOffset = 2; // 2 for SH1106 (centered in 132-col RAM), 0 for SSD1306
void playStartupVoiceTest();
// ============================================================================
// STARTUP AUDIO SELF-TEST: SEQUENTIALLY PLAY ALL 5 RECORDINGS AT BOOT
// ============================================================================
void playStartupVoiceTest() {
  Serial.println(F("\n=================================================="));
  Serial.println(F(">>> AUDIO SELF-TEST: PLAYING ALL 7 TRACKS IN ORDER"));
  Serial.println(F("=================================================="));

  for (uint8_t i = 1; i <= 7; i++) {
    Serial.print(F("[*] Playing Voice Track "));
    Serial.print(i);
    Serial.print(F(" of 7: "));

    if (displayAvailable) {
      display.clearDisplay();
      display.setTextSize(1);
      display.setTextColor(SSD1306_WHITE);
      display.setCursor(14, 6);
      display.println(F("AUDIO SELF-TEST"));
      display.drawLine(0, 16, 127, 16, SSD1306_WHITE);
      display.setCursor(16, 22);
      display.print(F("Voice "));
      display.print(i);
      display.println(F(" of 7:"));
      display.setTextSize(2);
      display.setCursor(4, 38);
    }

    switch (i) {
      case 1:
        Serial.println(F("'Help' (0001.mp3)"));
        if (displayAvailable) display.println(F("HELP!"));
        break;
      case 2:
        Serial.println(F("'Water' (0002.mp3)"));
        if (displayAvailable) display.println(F("WATER"));
        break;
      case 3:
        Serial.println(F("'I'm okay' (0003.mp3)"));
        if (displayAvailable) display.println(F("I'M OKAY"));
        break;
      case 4:
        Serial.println(F("'Thank you' (0004.mp3)"));
        if (displayAvailable) display.println(F("THANK YOU"));
        break;
      case 5:
        Serial.println(F("'Doctor' (0005.mp3)"));
        if (displayAvailable) display.println(F("DOCTOR!"));
        break;
      case 6:
        Serial.println(F("'Peace' (0006.mp3)"));
        if (displayAvailable) display.println(F("PEACE"));
        break;
      case 7:
        Serial.println(F("'Love' (0007.mp3)"));
        if (displayAvailable) display.println(F("LOVE"));
        break;
    }

    if (displayAvailable) refreshOLED(oledColOffset);

    playVoiceTrack(i);
    delay(2100); // Allow track to play fully
  }

  Serial.println(F("[[OK]] Startup Audio Self-Test Complete!"));
  Serial.println(F("==================================================\n"));
}
// ============================================================================
// HARDWARE OLED ANTI-GLITCH & CHARGE PUMP RECOVERY
// ============================================================================
void sendOledRecoveryCommands() {
  Wire.beginTransmission(0x3C);
  Wire.write((uint8_t)0x00);          // Control byte: Command stream follows
  Wire.write(0x8D); Wire.write(0x14); // Enable Charge Pump (SSD1306)
  Wire.write(0xAD); Wire.write(0x8B); // Enable DC-DC Pump (SH1106)
  Wire.write(0x20); Wire.write(0x02); // Page Addressing Mode (SSD1306 & SH1106 compatibility)
  Wire.write(0xAF);                   // Display ON
  Wire.write(0xA4);                   // Resume to RAM content display
  Wire.write(0xA6);                   // Normal display (non-inverted)
  Wire.write(0x81); Wire.write(0xCF); // Full contrast (bright display)
  Wire.write(0xD3); Wire.write(0x00); // Display Offset = 0
  Wire.write(0x40);                   // Display Start Line = 0
  Wire.write(0x2E);                   // Deactivate Scroll
  Wire.endTransmission();
}

void refreshOLED(uint8_t colOffset) {
  if (!displayAvailable) return;
  display.display();
}
// ============================================================================
// I2C HARDWARE BUS RECOVERY (Flushes locked slaves & resets TWI hardware)
// ============================================================================
void recoverI2CBus() {
  Wire.end();

  pinMode(A4, INPUT_PULLUP); // SDA (High-Z with pullup: NEVER drive HIGH as output!)
  pinMode(A5, OUTPUT);       // SCL

  // Clock SCL up to 9 times to release any hung slave
  for (uint8_t i = 0; i < 9; i++) {
    digitalWrite(A5, LOW);
    delayMicroseconds(10);
    digitalWrite(A5, HIGH);
    delayMicroseconds(10);
    if (digitalRead(A4) == HIGH) break; // Slave released SDA!
  }

  // Generate clean STOP condition without push-pull shorting
  pinMode(A4, OUTPUT);
  digitalWrite(A4, LOW);
  delayMicroseconds(10);
  digitalWrite(A5, HIGH);
  delayMicroseconds(10);
  pinMode(A4, INPUT_PULLUP); // Release SDA cleanly via pullup
  pinMode(A5, INPUT_PULLUP); // Release SCL cleanly via pullup
  delayMicroseconds(20);

  // Reinitialize Wire
  Wire.begin();
  Wire.setClock(100000);
  Wire.setWireTimeout(25000, true);
}
// ============================================================================
// ============================================================================
// DIGITAL PIN 2 RESISTANCE MEASUREMENT VIA RC DISCHARGE (Pinky Finger)
// ============================================================================
uint16_t readDigitalRC() {
  pinMode(2, OUTPUT);
  digitalWrite(2, HIGH);
  delayMicroseconds(50);
  pinMode(2, INPUT); // High-Z: let line discharge through flex sensor to GND
  
  uint16_t count = 0;
  while ((PIND & (1 << PD2)) && count < 2000) {
    count++;
  }
  pinMode(2, INPUT_PULLUP); // restore pullup
  return count;
}
// FLAT HAND BASELINE CALIBRATION
// ============================================================================
void calibrateFlatBaseline() {
  Serial.println(F("\n[*] CALIBRATING FLAT BASELINE (Hold hand flat)..."));

  if (displayAvailable) {
    display.clearDisplay();
    display.setTextSize(1);
    display.setTextColor(SSD1306_WHITE);
    display.setCursor(16, 10);
    display.println(F("CALIBRATING..."));
    display.drawLine(10, 22, 117, 22, SSD1306_WHITE);
    display.setCursor(12, 30);
    display.println(F("HOLD HAND FLAT"));
    display.setCursor(16, 46);
    display.println(F("Relax fingers"));
    refreshOLED(oledColOffset);
  }

  // Pre-sampling delay to ensure voltages on analog lines are settled
  delay(600);

  for (uint8_t i = 0; i < NUM_FLEX; i++) {
    uint16_t sBuf[25];
    if (IS_ANALOG[i]) {
      for (uint8_t s = 0; s < 25; s++) {
        analogRead(FLEX_PINS[i]);
        delayMicroseconds(80);
        sBuf[s] = analogRead(FLEX_PINS[i]);
        delay(12);
      }
    } else {
      for (uint8_t s = 0; s < 25; s++) {
        sBuf[s] = readDigitalRC();
        delay(12);
      }
    }
    // Sort to find the median sample (rejects noise spikes & transient drift)
    for (uint8_t a = 0; a < 25; a++) {
      for (uint8_t b = a + 1; b < 25; b++) {
        if (sBuf[b] < sBuf[a]) {
          uint16_t tmp = sBuf[a];
          sBuf[a] = sBuf[b];
          sBuf[b] = tmp;
        }
      }
    }
    flexSensors[i].baseline = sBuf[12]; // Median: true resting center!
    flexSensors[i].raw = flexSensors[i].baseline;
    flexSensors[i].bendPercent = 0;
    flexSensors[i].isBent = false;
    Serial.print(F("  "));
    Serial.print(FINGER_INITIALS[i]);
    Serial.print(F(" Baseline = "));
    Serial.println(flexSensors[i].baseline);
  }

  Serial.println(F("[[OK]] Flat Baseline Calibrated Successfully!\n"));
}
// ============================================================================
// SETUP
// ============================================================================
void setup() {
  uint8_t mcusr_val = MCUSR;
  MCUSR = 0;
  pinMode(LED_PIN, OUTPUT);

  digitalWrite(LED_PIN, HIGH);

  Serial.begin(115200);

  delay(400);

  Serial.println(F("\n=================================================="));

  Serial.println(F("  SIGNBRIDGE - 5 FLEX + MPU6050 + OLED GLOVE      "));
  Serial.print(F("[RESET REASON] MCUSR = 0x")); Serial.println(mcusr_val, HEX);

  Serial.println(F("=================================================="));

  // 1. Flush I2C Bus & Clear any stuck slave state
  recoverI2CBus();
  delay(50);
  Wire.begin();
  Wire.setClock(100000);            // Stable 100kHz: ultra-reliable over wires
  Wire.setWireTimeout(25000, true); // 25ms timeout with auto-reset

// 2. Initialize Flex Sensor Pin Modes
  for (uint8_t i = 0; i < NUM_FLEX; i++) {
    pinMode(FLEX_PINS[i], INPUT_PULLUP); // All pins use internal pull-up for 2-wire sensors to GND!

    flexSensors[i].raw = 0;
    flexSensors[i].baseline = 900;
    flexSensors[i].minVal = 0;
    flexSensors[i].maxVal = 1023;
    flexSensors[i].bendPercent = 0;
    flexSensors[i].isBent = false;
    flexSensors[i].inverted = false;
  }

  // 3. Initialize OLED Display (0x3C)
  delay(50);
  Serial.print(F("[*] Initializing OLED Display (0x3C)... "));
  Wire.begin();
  Wire.setClock(100000);

  bool oledOk = display.begin(SSD1306_SWITCHCAPVCC, 0x3C);
  if (oledOk) {
    displayAvailable = true;
    display.setRotation(2);
    display.dim(false);
    Serial.println(F("CONNECTED READY [OK]"));

    // Quick white flash on boot so wearer knows display is powered!
    display.clearDisplay();
    display.fillScreen(SSD1306_WHITE);
    display.display();
    delay(250);

    display.clearDisplay();
    display.setTextSize(1);
    display.setTextColor(SSD1306_WHITE);
    display.setCursor(14, 15);
    display.println(F("SIGNBRIDGE GLOVE"));
    display.setCursor(16, 32);
    display.println(F("OLED ACTIVE"));
    display.display();
  } else {
    displayAvailable = false;
    Serial.println(F("NOT DETECTED (Check 0x3C wiring)"));
  }

  // Scan I2C bus to report all detected devices
  scanI2C();

  // 4. Initialize MPU6050 IMU via direct lightweight I2C driver (probes 0x68 and 0x69)

  Serial.print(F("[*] Initializing MPU6050 IMU... "));

  if (initMPU6050()) {

    mpuAvailable = true;

    Serial.print(F("CONNECTED [OK] at 0x"));

    Serial.println(mpuAddress, HEX);

  } else {

    mpuAvailable = false;

    Serial.println(F("NOT DETECTED (Connect VCC, GND, SDA->A4, SCL->A5)"));

  }

  // 5. Initialize DFPlayer Mini Audio (Pins 10/11)
  pinMode(BUZZER_PIN, INPUT);
      
  Serial.print(F("[*] Initializing DFPlayer Mini Audio (Pins 10/11)... "));

  pinMode(10, OUTPUT);
  pinMode(11, OUTPUT);
  digitalWrite(10, HIGH);    // Idle HIGH for UART
  digitalWrite(11, HIGH);    // Idle HIGH for UART

  delay(1200); // Allow Micro-SD card to auto-mount filesystem
  dfplayer_send_cmd(0x06, 30); // Set volume to 30/30 (Maximum)
  delay(200);

  // Play startup confirmation chime: Track 5 ('Doctor!')
  Serial.println(F("[*] Boot Audio Check: Playing Track 5 ('Doctor!')..."));
  playVoiceTrack(5);
  delay(300);

  Serial.print(F("READY [OK] (Volume "));
  Serial.print(dfPlayerVolume);
  Serial.println(F("/30)"));

  // 6. Audio Startup Self-Test (Disabled on boot: audio plays on laptop!)
  // playStartupVoiceTest();

  // 7. Calibrate Flat Baseline (Samples resting hand to ensure bars sit at 0%!)
  calibrateFlatBaseline();

  Serial.println(F("[[OK]] System Initialized & Ready for Gestures!"));
  Serial.println(F("==================================================\n"));

  digitalWrite(LED_PIN, LOW);
}
// ============================================================================
// MAIN LOOP (~35Hz refresh rate for instant, silky response)
// ============================================================================
void loop() {

  handleSerialCommands();

  readFlexSensors();

  readMPU6050();

  classifyOrientation();

  detectGesture();

  updateDisplay();

  printSerialOutput();

  delay(10); // Snappy loop delay
}
// ============================================================================
// FLEX SENSOR ACQUISITION & FAST DYNAMIC FILTERING (ANTI-CROSSTALK ENGINE)
// ============================================================================
void readFlexSensors() {

  uint16_t diffs[NUM_FLEX] = {0};
  uint16_t maxDiff = 0;

  // PASS 1: Sample all raw signals and compute absolute deflection from resting baseline
  for (uint8_t i = 0; i < NUM_FLEX; i++) {
    if (IS_ANALOG[i]) {
      // Clean Anti-Ghosting ADC Read: Discard 1st read to switch AVR mux capacitor, wait 80us
      analogRead(FLEX_PINS[i]);
      delayMicroseconds(80);
      uint16_t r1 = analogRead(FLEX_PINS[i]);
      delayMicroseconds(50);
      uint16_t r2 = analogRead(FLEX_PINS[i]);
      uint16_t reading = (r1 + r2) / 2;

      flexSensors[i].raw = ((uint32_t)flexSensors[i].raw * 3 + reading) / 4;

      if (reading > flexSensors[i].baseline) {
        diffs[i] = reading - flexSensors[i].baseline;
      } else {
        diffs[i] = flexSensors[i].baseline - reading;
      }
    } else {
      // Ring finger on Digital Pin 2 (Index 3):
      uint16_t rcReading = readDigitalRC();
      flexSensors[i].raw = rcReading;

      if (rcReading > flexSensors[i].baseline) {
        diffs[i] = rcReading - flexSensors[i].baseline;
      } else {
        diffs[i] = flexSensors[i].baseline - rcReading;
      }
    }

    if (diffs[i] > maxDiff) {
      maxDiff = diffs[i];
    }
  }

  // PASS 2: Intelligent Glove Cross-Pull & Fabric Drag Suppression
  // When one finger bends intentionally (e.g. Index), glove fabric pulls adjacent sensors slightly (4-7 counts).
  // If a finger's movement is small compared to the active bending finger, it is suppressed as mechanical drag!
  for (uint8_t i = 0; i < NUM_FLEX; i++) {
    if (IS_ANALOG[i]) {
      const uint8_t deadband = 7;     // Clean 7-count floor rejects micro-wobble
      const uint16_t spanMax = 35;    // Reach 100% full scale at 35 count bend
      const uint8_t zeroClamp = 4;

      // Fabric drag filter removed: allow all genuine finger deflections!

      uint8_t targetPct = 0;
      if (diffs[i] > deadband) {
        targetPct = map(constrain(diffs[i], deadband, spanMax), deadband, spanMax, 0, 100);
      }

      // Smooth moving average: snappy 65/35 response
      if (targetPct > 0) {
        flexSensors[i].bendPercent = ((uint16_t)flexSensors[i].bendPercent * 65 + (uint16_t)targetPct * 35) / 100;
      } else {
        flexSensors[i].bendPercent = ((uint16_t)flexSensors[i].bendPercent * 50) / 100;
      }

      if (flexSensors[i].bendPercent <= zeroClamp) {
        flexSensors[i].bendPercent = 0;
      }

      if (flexSensors[i].bendPercent > 20) {
        flexSensors[i].isBent = true;
      } else if (flexSensors[i].bendPercent < 10) {
        flexSensors[i].isBent = false;
      }

    } else {
      // Ring finger on Digital Pin 2 (Index 3):
      const uint8_t rcDeadband = 5;
      const uint8_t rcSpan = 20;

      // Cross-pull filter removed

      uint8_t rcPct = 0;
      if (diffs[i] > rcDeadband) {
        rcPct = map(constrain(diffs[i], rcDeadband, rcSpan), rcDeadband, rcSpan, 0, 100);
      }

      if (rcPct > 0) {
        flexSensors[i].bendPercent = ((uint16_t)flexSensors[i].bendPercent * 65 + (uint16_t)rcPct * 35) / 100;
      } else {
        flexSensors[i].bendPercent = ((uint16_t)flexSensors[i].bendPercent * 50) / 100;
      }

      if (flexSensors[i].bendPercent <= 4) {
        flexSensors[i].bendPercent = 0;
      }

      if (flexSensors[i].bendPercent > 20) {
        flexSensors[i].isBent = true;
      } else if (flexSensors[i].bendPercent < 10) {
        flexSensors[i].isBent = false;
      }
    }
  }
}
// ============================================================================
// DIRECT LIGHTWEIGHT MPU6050 DRIVER (Zero library overhead!)
// ============================================================================
bool initMPU6050() {
  for (uint8_t attempt = 0; attempt < 3; attempt++) {
    // 1. Auto-detect whether MPU is at address 0x68 or 0x69 (AD0 pin)
    Wire.beginTransmission(0x68);
    if (Wire.endTransmission() == 0) {
      mpuAddress = 0x68;
    } else {
      Wire.beginTransmission(0x69);
      if (Wire.endTransmission() == 0) {
        mpuAddress = 0x69;
      } else {
        delay(15);
        continue;
      }
    }

    // Wake up MPU6050 (write 0 to PWR_MGMT_1 register 0x6B)
    Wire.beginTransmission(mpuAddress);
    Wire.write((uint8_t)0x6B);
    Wire.write((uint8_t)0x00);
    if (Wire.endTransmission() == 0) {
      delay(15); // PLL clock stabilization
      // Set Accelerometer range to +/- 4G (register 0x1C = 0x08)
      Wire.beginTransmission(mpuAddress);
      Wire.write(0x1C);
      Wire.write(0x08);
      Wire.endTransmission();

      // Set Gyroscope range to +/- 500 deg/s (register 0x1B = 0x08)
      Wire.beginTransmission(mpuAddress);
      Wire.write(0x1B);
      Wire.write(0x08);
      Wire.endTransmission();
      return true;
    }
    delay(20);
  }
  return false;
}
void readMPU6050() {
  static unsigned long lastMpuCheck = 0;
  static uint8_t mpuFailCount = 0;

  if (!mpuAvailable) {
    if (millis() - lastMpuCheck > 1000) {
      lastMpuCheck = millis();
      if (initMPU6050()) {
        mpuAvailable = true;
        mpuFailCount = 0;
        Serial.print(F("[!] MPU6050 RECONNECTED [OK] at 0x"));
        Serial.println(mpuAddress, HEX);
      }
    }
    return;
  }

  // Use Repeated Start (false) so MPU6050 register pointer stays locked
  Wire.beginTransmission(mpuAddress);
  Wire.write(0x3B); // Starting at ACCEL_XOUT_H
  uint8_t txErr = Wire.endTransmission(false);
  if (txErr != 0) {
    if (++mpuFailCount > 8) {
      mpuAvailable = false;
      mpuFailCount = 0;
    }
    if (Wire.getWireTimeoutFlag()) Wire.clearWireTimeoutFlag();
    return;
  }
  mpuFailCount = 0;

  // Read 14 bytes: Ax, Ay, Az, Temp, Gx, Gy, Gz

  if (Wire.requestFrom((uint8_t)mpuAddress, (uint8_t)14, (uint8_t)1) == 14) {

    int16_t rawAx = (Wire.read() << 8) | Wire.read();

    int16_t rawAy = (Wire.read() << 8) | Wire.read();

    int16_t rawAz = (Wire.read() << 8) | Wire.read();

    Wire.read(); Wire.read(); // Skip temp

    int16_t rawGx = (Wire.read() << 8) | Wire.read();

    int16_t rawGy = (Wire.read() << 8) | Wire.read();

    int16_t rawGz = (Wire.read() << 8) | Wire.read();

    // Convert raw to physical units (+/- 4G -> 8192 LSB/g)

    motion.ax = (rawAx / 8192.0f) * 9.81f;

    motion.ay = (rawAy / 8192.0f) * 9.81f;

    motion.az = (rawAz / 8192.0f) * 9.81f;

    // Convert raw gyro (+/- 500 deg/s -> 65.5 LSB/(deg/s))

    motion.gx = rawGx / 65.5f;

    motion.gy = rawGy / 65.5f;

    motion.gz = rawGz / 65.5f;

    // Pitch (-90 to +90 deg) and Roll (-180 to +180 deg)

    motion.roll  = atan2(motion.ay, motion.az) * 57.29578f;

    float denom  = sqrt(motion.ay * motion.ay + motion.az * motion.az);

    motion.pitch = atan2(-motion.ax, denom) * 57.29578f;

    // Dynamic movement (wave / shake)

    float totalG = sqrt(motion.ax * motion.ax + motion.ay * motion.ay + motion.az * motion.az);

    motion.dynamicAccel = abs(totalG - 9.81f);

    motion.gyroEnergy   = sqrt(motion.gx * motion.gx + motion.gy * motion.gy + motion.gz * motion.gz);

    if (motion.dynamicAccel > 3.8f || motion.gyroEnergy > 120.0f) {

      motion.isMoving = true;

    } else if (motion.dynamicAccel < 1.2f && motion.gyroEnergy < 40.0f) {

      motion.isMoving = false;

    }

  }
}
// ============================================================================
// WRIST POSE CLASSIFICATION
// ============================================================================
void classifyOrientation() {

  if (!mpuAvailable) {

    currentPose = POSE_FLAT;

    return;

  }

  if (motion.pitch > 35.0f) {

    currentPose = POSE_UP;          // Hand tilted up / Stop sign

  } else if (motion.pitch < -35.0f) {

    currentPose = POSE_DOWN;        // Hand pointing downward

  } else if (motion.roll > 40.0f && motion.roll < 140.0f) {

    currentPose = POSE_TILT_RIGHT;  // Tilted right

  } else if (motion.roll < -40.0f && motion.roll > -140.0f) {

    currentPose = POSE_TILT_LEFT;   // Tilted left

  } else if (abs(motion.roll) > 140.0f) {

    currentPose = POSE_PALM_UP;     // Palm facing ceiling

  } else {

    currentPose = POSE_FLAT;        // Palm horizontal / neutral

  }
}
// ============================================================================
// GESTURE RECOGNITION ENGINE (Fingers + Wrist Motion)
// ============================================================================
void detectGesture() {

  // Dynamic bend detection
  bool thumb = (flexSensors[0].bendPercent >= 20);
  bool index = (flexSensors[1].bendPercent >= 20);
  bool mid   = (flexSensors[2].bendPercent >= 20);
  bool ring  = (flexSensors[3].bendPercent >= 20);
  bool pinky = (flexSensors[4].bendPercent >= 20);

  uint8_t curledCount = (thumb ? 1 : 0) + (index ? 1 : 0) + (mid ? 1 : 0) + (ring ? 1 : 0) + (pinky ? 1 : 0);

  GestureId candidate = GESTURE_NONE;

  // 1. FLAT / OPEN HAND (Placed flat on surface / all fingers straight) -> DOCTOR!
  if (curledCount == 0 || (!index && !mid && !ring && !pinky)) {
    candidate = GESTURE_CALL_DOCTOR;
  }
  // 2. CLOSED FIST -> HELP!
  else if ((curledCount >= 4) || (index && mid && ring)) {
    candidate = GESTURE_NEED_HELP;
  }
  // 3. THUMBS UP -> THANK YOU
  else if (!thumb && index && mid && (curledCount >= 2)) {
    candidate = GESTURE_THANK_YOU;
  }
  // 4. I LOVE YOU (ILY) -> LOVE
  else if (!thumb && !index && !pinky && (mid || ring)) {
    candidate = GESTURE_LOVE;
  }
  // 5. PEACE SIGN -> PEACE
  else if (!index && !mid && (ring || pinky) && curledCount >= 1) {
    candidate = GESTURE_PEACE;
  }
  // 6. POINTING INDEX -> WATER
  else if (!index && mid && (ring || pinky || curledCount >= 2)) {
    candidate = GESTURE_WANT_WATER;
  }
  // 7. OK SIGN -> I'M OKAY
  else if (thumb && index && !mid && !ring && curledCount <= 3) {
    candidate = GESTURE_AM_OKAY;
  }
  else {
    candidate = GESTURE_NONE;
  }

  // State Machine: Triggers each new gesture ONCE after holding 180ms, does not repeat
  static GestureId activeGesture = GESTURE_NONE;
  static unsigned long holdStart = 0;
  static GestureId lastTriggered = GESTURE_NONE;

  if (candidate != activeGesture) {
    activeGesture = candidate;
    holdStart = millis();
  } else {
    // If neutral / resting hand, release lock after 120ms so same gesture can trigger again!
    if (activeGesture == GESTURE_NONE) {
      if (millis() - holdStart >= 120) {
        lastTriggered = GESTURE_NONE;
      }
    } else if (activeGesture != lastTriggered && (millis() - holdStart >= 180)) {
      currentGesture = activeGesture;
      triggerGestureAudio(currentGesture);
      lastTriggered = activeGesture;
      lastTriggerTime = millis();
      lastTriggeredGesture = currentGesture;
    }
  }
}
// ============================================================================
// GESTURE TRIGGER (DFPlayer Mini Voice Output)
// ============================================================================
void triggerGestureAudio(GestureId g) {
  // Voice playback cooldown: prevent playing tracks from stuttering or getting chopped
  static unsigned long lastAudioPlayTime = 0;
  if (millis() - lastAudioPlayTime < 1800) {
    return; // Wait for track to finish playing!
  }
  lastAudioPlayTime = millis();

  digitalWrite(LED_PIN, HIGH);
  pinMode(BUZZER_PIN, INPUT);

  switch (g) {

    case GESTURE_NEED_HELP:
      Serial.println(F("GESTURE:NEED_HELP"));
            playVoiceTrack(1); // Track 1: "I need help"
                  break;

    case GESTURE_WANT_WATER:
      Serial.println(F("GESTURE:WANT_WATER"));
            playVoiceTrack(2); // Track 2: "Please give me water"
                  break;

    case GESTURE_AM_OKAY:
      Serial.println(F("GESTURE:AM_OKAY"));
            playVoiceTrack(3); // Track 3: "I am okay"
                  break;

    case GESTURE_THANK_YOU:
      Serial.println(F("GESTURE:THANK_YOU"));
            playVoiceTrack(4); // Track 4: "Thank you"
                              break;

    case GESTURE_PEACE:
      Serial.println(F("GESTURE:PEACE"));
      playVoiceTrack(6); // Track 6: "Peace" (matches OLED: PEACE)
      break;

    case GESTURE_LOVE:
      Serial.println(F("GESTURE:LOVE"));
      playVoiceTrack(7); // Track 7: "Love" (matches OLED: LOVE)
      break;

    case GESTURE_CALL_DOCTOR:
      Serial.println(F("GESTURE:CALL_DOCTOR"));
            playVoiceTrack(5); // Track 5: "Please call a doctor"
                              break;

    default:
      break;

  }

  digitalWrite(LED_PIN, LOW);
}
// ============================================================================
// OLED DISPLAY REFRESH (Clean & Stable 20 FPS)
// ============================================================================
void updateDisplay() {

  // Rate-limit OLED redraws to stable ~6.6 FPS (150ms) - snappy & low bus load
  static unsigned long lastOledRefresh = 0;
  if (millis() - lastOledRefresh < 150) return;
  lastOledRefresh = millis();

  // Auto-reconnect if OLED was previously offline (probe every 2s)
  if (!displayAvailable) {
    static unsigned long lastOledRetry = 0;
    if (millis() - lastOledRetry > 2000) {
      lastOledRetry = millis();
      Wire.beginTransmission(0x3C);
      Wire.write((uint8_t)0x00);
      if (Wire.endTransmission() == 0) {
        if (display.begin(SSD1306_SWITCHCAPVCC, 0x3C, false, false)) {
          display.setRotation(2);
          display.dim(false);
          displayAvailable = true;
          sendOledRecoveryCommands();
          Serial.println(F("[!] OLED RECONNECTED & READY [OK]"));
        }
      }
    }
    if (!displayAvailable) return;
  }

  // Ultra-Aggressive OLED Charge-Pump & Power Relight Watchdog (every 800ms)
  // Guarantees that even if a voltage dip or bus glitch momentarily turns off the OLED pump,
  // it is forcibly turned back ON and illuminated immediately!
  // Watchdog: keep display clean without corrupting I2C addressing mode
  static unsigned long lastGlitchCheck = 0;
  if (millis() - lastGlitchCheck > 1500) {
    lastGlitchCheck = millis();
    displayAvailable = true;
  }



  display.clearDisplay();

  // 1. Header Bar

  display.setTextSize(1);

  display.setTextColor(SSD1306_WHITE);

  display.setCursor(0, 0);

  display.print(F("SIGNBRIDGE"));

  display.setCursor(76, 0);

  if (motion.isMoving) {

    display.print(F("[WAVE!]"));

  } else if (mpuAvailable) {

    display.print(F("[STABLE]"));

  } else {

    display.print(F("[FLEX5]"));

  }

  display.drawLine(0, 9, 127, 9, SSD1306_WHITE);

  // 2. 5-Finger Gauge Bars (T, I, M, R, P)

  for (uint8_t i = 0; i < NUM_FLEX; i++) {

    int x = 4 + (i * 25);

    int y = 12;

    display.setCursor(x + 7, y);

    display.print(FINGER_INITIALS[i]);

    display.drawRect(x, y + 9, 20, 7, SSD1306_WHITE);

    // Filter sub-5% jitter so gauges stay perfectly empty at rest:
    int fillW = (flexSensors[i].bendPercent > 5) ? map(flexSensors[i].bendPercent, 5, 100, 1, 18) : 0;

    if (fillW > 0) {

      display.fillRect(x + 1, y + 10, fillW, 5, SSD1306_WHITE);

    }

  }

  // 3. Wrist Angles / Status Bar

  display.setCursor(0, 30);

  if (mpuAvailable) {

    display.print(F("P:"));

    display.print((int)motion.pitch);

    display.print((char)247);

    display.print(F(" R:"));

    display.print((int)motion.roll);

    display.print((char)247);

    display.setCursor(80, 30);

    switch (currentPose) {

      case POSE_UP:         display.print(F("UP")); break;

      case POSE_DOWN:       display.print(F("DOWN")); break;

      case POSE_TILT_LEFT:  display.print(F("LEFT")); break;

      case POSE_TILT_RIGHT: display.print(F("RIGHT")); break;

      case POSE_PALM_UP:    display.print(F("PLM-UP")); break;

      default:              display.print(F("FLAT")); break;

    }

  } else {

    display.print(F("GLOVE SENSORS ACTIVE"));

  }

  display.drawLine(0, 39, 127, 39, SSD1306_WHITE);

  // 4. Recognized Gesture Banner

  display.setCursor(0, 42);

  display.print(F("Gesture:"));

  display.setTextSize(2);

  display.setCursor(4, 50);

  GestureId active = (lastTriggeredGesture != GESTURE_NONE && (millis() - lastTriggerTime < 2200))

                     ? lastTriggeredGesture : currentGesture;

  switch (active) {

    case GESTURE_NEED_HELP:

      display.print(F("HELP!"));

      break;

    case GESTURE_WANT_WATER:

      display.print(F("WATER"));

      break;

    case GESTURE_AM_OKAY:

      display.print(F("I'M OKAY"));

      break;

    case GESTURE_THANK_YOU:

      display.print(F("THANK YOU"));

      break;

    case GESTURE_PEACE:

      display.print(F("PEACE"));

      break;

    case GESTURE_LOVE:

      display.print(F("LOVE"));

      break;

    case GESTURE_CALL_DOCTOR:

      display.print(F("DOCTOR!"));

      break;

    default:

      display.setTextSize(1);

      display.setCursor(24, 53);

      display.print(F("Listening..."));

      break;

  }

  refreshOLED(oledColOffset);

  if (Wire.getWireTimeoutFlag()) {

    Wire.clearWireTimeoutFlag();

  }
}
// ============================================================================
// SERIAL TELEMETRY OUTPUT (Live Stream for Arduino Serial Plotter)
// ============================================================================
void printSerialOutput() {

  static unsigned long lastPrint = 0;

  if (millis() - lastPrint < 40) return; // ~25Hz refresh rate

  lastPrint = millis();

  if (currentMode == MODE_PLOTTER_RAW) {

    // Format for Arduino IDE Serial Plotter:

    Serial.print(F("Thumb:"));  Serial.print(flexSensors[0].raw); Serial.print(F(","));

    Serial.print(F("Index:"));  Serial.print(flexSensors[1].raw); Serial.print(F(","));

    Serial.print(F("Middle:")); Serial.print(flexSensors[2].raw); Serial.print(F(","));

    Serial.print(F("Ring:"));   Serial.print(flexSensors[3].bendPercent > 0 ? 1023 : 0); Serial.print(F(","));

    Serial.print(F("Pinky:"));  Serial.print(flexSensors[4].raw);

    if (mpuAvailable) {

      Serial.print(F(",Pitch:")); Serial.print((int)motion.pitch);

      Serial.print(F(",Roll:"));  Serial.print((int)motion.roll);

      Serial.print(F(",Wave:"));  Serial.print(motion.isMoving ? 800 : 0);

    }

    Serial.println();

  }

  else if (currentMode == MODE_PLOTTER_PCT) {

    Serial.print(F("Thumb:"));  Serial.print(flexSensors[0].bendPercent); Serial.print(F(","));

    Serial.print(F("Index:"));  Serial.print(flexSensors[1].bendPercent); Serial.print(F(","));

    Serial.print(F("Middle:")); Serial.print(flexSensors[2].bendPercent); Serial.print(F(","));

    Serial.print(F("Ring:"));   Serial.print(flexSensors[3].bendPercent); Serial.print(F(","));

    Serial.print(F("Pinky:"));  Serial.print(flexSensors[4].bendPercent);

    if (mpuAvailable) {

      Serial.print(F(",Pitch:")); Serial.print((int)motion.pitch);

      Serial.print(F(",Roll:"));  Serial.print((int)motion.roll);

      Serial.print(F(",Wave:"));  Serial.print(motion.isMoving ? 100 : 0);

    }

    Serial.println();

  }

  else if (currentMode == MODE_DIAGNOSTIC) {

    Serial.print(F("[FLEX] "));

    for (uint8_t i = 0; i < NUM_FLEX; i++) {

      Serial.print(FINGER_INITIALS[i]);

      Serial.print(F(":"));

      Serial.print(flexSensors[i].raw);

      Serial.print(F("("));

      Serial.print(flexSensors[i].bendPercent);

      Serial.print(F("%) "));

    }

    if (mpuAvailable) {

      Serial.print(F("| P:"));

      Serial.print((int)motion.pitch);

      Serial.print(F(" R:"));

      Serial.print((int)motion.roll);

      Serial.print(F(" DynG:"));

      Serial.print(motion.dynamicAccel, 1);

      Serial.print(F(" Mov:"));

      Serial.print(motion.isMoving ? F("YES") : F("NO"));

    }

    Serial.println();

  }
}
// ============================================================================
// SERIAL COMMAND HANDLER
// ============================================================================
void scanI2C() {
  Serial.println(F("--- I2C BUS SCAN ---"));
  int count = 0;
  for (byte address = 1; address < 127; address++) {
    Wire.beginTransmission(address);
    byte error = Wire.endTransmission();
    if (Wire.getWireTimeoutFlag()) Wire.clearWireTimeoutFlag();
    if (error == 0) {
      Serial.print(F("Found device at: 0x"));
      Serial.print(address, HEX);
      if (address == 0x3C || address == 0x3D) Serial.println(F(" (OLED Display)"));
      else if (address == 0x68 || address == 0x69) Serial.println(F(" (MPU6050 IMU)"));
      else Serial.println();
      count++;
    }
  }
  Serial.print(F("Total found: "));
  Serial.println(count);
  Serial.println(F("--------------------"));
}
void handleSerialCommands() {

  if (!Serial.available()) return;

  char cmd = Serial.read();
  while (Serial.available()) Serial.read(); // Flush extra bytes to prevent command loops!

  if (cmd == 'i' || cmd == 'I') {

    scanI2C();

  } else if (cmd == 'c' || cmd == 'C') {

    calibrateFlatBaseline();

  } else if (cmd == 'k' || cmd == 'K') {

    runAutoCalibration();

  } else if (cmd == 'r' || cmd == 'R') {

    currentMode = MODE_PLOTTER_RAW;

    Serial.println(F("[*] Switched to RAW ADC GRAPH mode"));

  } else if (cmd == 'p' || cmd == 'P') {

    currentMode = MODE_PLOTTER_PCT;

    Serial.println(F("[*] Switched to PERCENTAGE GRAPH mode"));

  } else if (cmd == 'd' || cmd == 'D') {

    currentMode = MODE_DIAGNOSTIC;

    Serial.println(F("[*] Switched to RAW HARDWARE DIAGNOSTIC mode"));

  } else if (cmd == 'o' || cmd == 'O') {

    Serial.print(F("[*] Re-initializing OLED Display (0x3C)... "));

    if (display.begin(SSD1306_SWITCHCAPVCC, 0x3C, false, false)) {
      display.setRotation(2);
      display.dim(false);

      display.clearDisplay();

      display.setTextSize(2);

      display.setTextColor(SSD1306_WHITE);

      display.setCursor(10, 24);

      display.print(F("SIGNBRIDGE"));

      refreshOLED(oledColOffset);

      displayAvailable = true;

      Serial.println(F("READY [OK]"));

    } else {

      Serial.println(F("NOT DETECTED at 0x3C"));

    }

  } else if (cmd == 'f' || cmd == 'F') {

    static uint8_t rot = 2;
    rot = (rot == 2) ? 0 : 2;
    display.setRotation(rot);
    Serial.print(F("[*] Switched OLED Rotation to: "));
    Serial.println(rot);
    refreshOLED(oledColOffset);

  } else if (cmd >= '1' && cmd <= '7') {

    triggerGestureAudio((GestureId)(cmd - '0'));

  } else if (cmd == 'v' || cmd == 'V') {
    uint16_t sdaV = analogRead(A4);
    uint16_t sclV = analogRead(A5);
    Serial.print(F("[BUS VOLTAGE] SDA (A4) = "));
    Serial.print((sdaV * 5.0f) / 1023.0f, 2);
    Serial.print(F("V | SCL (A5) = "));
    Serial.print((sclV * 5.0f) / 1023.0f, 2);
    Serial.println(F("V"));
  } else if (cmd == 'x' || cmd == 'X') {
    oledColOffset = (oledColOffset == 2) ? 0 : 2;
    Serial.print(F("[*] Switched OLED Column Offset to: "));
    Serial.println(oledColOffset);
    refreshOLED(oledColOffset);
  } else if (cmd == 't' || cmd == 'T') {

    Serial.println(F("[*] Audio Test: Playing Track 1 ('I need help')..."));

    playVoiceTrack(1);

  } else if (cmd == '+' || cmd == '=') {

    if (dfPlayerVolume < 30) dfPlayerVolume++;

    dfplayer_send_cmd(0x06, dfPlayerVolume);

    Serial.print(F("[*] DFPlayer Volume: "));

    Serial.print(dfPlayerVolume);

    Serial.println(F("/30"));

  } else if (cmd == '-' || cmd == '_') {

    if (dfPlayerVolume > 0) dfPlayerVolume--;

    dfplayer_send_cmd(0x06, dfPlayerVolume);

    Serial.print(F("[*] DFPlayer Volume: "));

    Serial.print(dfPlayerVolume);

    Serial.println(F("/30"));

  } else if (cmd == 'b' || cmd == 'B') {

    Serial.println(F("[*] Buzzer Test Chime!"));

    
    delay(120);

    
    delay(120);

    
  }
}
// ============================================================================
// 2-STEP GUIDED AUTO-CALIBRATION ROUTINE
// ============================================================================
void runAutoCalibration() {

  Serial.println(F("\n=================================================="));

  Serial.println(F("      FLEX SENSOR AUTO-CALIBRATION PROCEDURE      "));

  Serial.println(F("=================================================="));

  if (displayAvailable) {

    display.clearDisplay();

    display.setTextSize(1);

    display.setCursor(0, 5);

    display.println(F("CALIBRATION MODE"));

    display.println(F("-----------------"));

    display.println(F("Step 1:"));

    display.println(F("HOLD HAND OPEN"));

    display.println(F("& STRAIGHT..."));

    refreshOLED(oledColOffset);

  }

  Serial.println(F("[STEP 1/2]: Keep all 5 fingers completely FLAT & STRAIGHT."));

  Serial.println(F("Sampling in 3 seconds..."));

  for (int i = 3; i > 0; i--) {

    Serial.print(i); Serial.print(F("... "));

    delay(1000);

  }

  Serial.println(F("SAMPLING STRAIGHT POSITIONS!"));

  uint32_t straightSum[NUM_FLEX] = {0};

  const int SAMPLES = 30;

  for (int s = 0; s < SAMPLES; s++) {

    for (uint8_t i = 0; i < NUM_FLEX; i++) {

      if (IS_ANALOG[i]) {

        straightSum[i] += analogRead(FLEX_PINS[i]);

      } else {

        straightSum[i] += digitalRead(FLEX_PINS[i]);

      }

    }

    delay(20);

  }

  for (uint8_t i = 0; i < NUM_FLEX; i++) {

    flexSensors[i].minVal = straightSum[i] / SAMPLES;

    flexSensors[i].baseline = flexSensors[i].minVal;

    Serial.print(F("  "));

    Serial.print(FINGER_INITIALS[i]);

    Serial.print(F(" Flat ADC = "));

    Serial.println(flexSensors[i].minVal);

  }

  if (displayAvailable) {

    display.clearDisplay();

    display.setCursor(0, 5);

    display.println(F("CALIBRATION MODE"));

    display.println(F("-----------------"));

    display.println(F("Step 2:"));

    display.println(F("CLOSE INTO A"));

    display.println(F("TIGHT FIST..."));

    refreshOLED(oledColOffset);

  }

  Serial.println(F("\n[STEP 2/2]: Close hand into a TIGHT FIST (Bending all fingers)."));

  Serial.println(F("Sampling in 3 seconds..."));

  for (int i = 3; i > 0; i--) {

    Serial.print(i); Serial.print(F("... "));

    delay(1000);

  }

  Serial.println(F("SAMPLING BENT POSITIONS!"));

  uint32_t bentSum[NUM_FLEX] = {0};

  for (int s = 0; s < SAMPLES; s++) {

    for (uint8_t i = 0; i < NUM_FLEX; i++) {

      if (IS_ANALOG[i]) {

        bentSum[i] += analogRead(FLEX_PINS[i]);

      } else {

        bentSum[i] += digitalRead(FLEX_PINS[i]);

      }

    }

    delay(20);

  }

  for (uint8_t i = 0; i < NUM_FLEX; i++) {

    flexSensors[i].maxVal = bentSum[i] / SAMPLES;

    if (flexSensors[i].maxVal < flexSensors[i].minVal) {

      flexSensors[i].inverted = true;

    } else {

      flexSensors[i].inverted = false;

    }

    Serial.print(F("  "));

    Serial.print(FINGER_INITIALS[i]);

    Serial.print(F(" Bent ADC = "));

    Serial.print(flexSensors[i].maxVal);

    if (flexSensors[i].inverted) {

      Serial.println(F(" [Inverted Divider]"));

    } else {

      Serial.println(F(" [Normal Divider]"));

    }

  }

  Serial.println(F("\n[[OK]] Calibration Complete! Dynamic ranges saved."));

  Serial.println(F("==================================================\n"));

  if (displayAvailable) {

    display.clearDisplay();

    display.setCursor(10, 20);

    display.println(F("CALIBRATION DONE!"));

    display.setCursor(10, 36);

    display.println(F("Ready to detect!"));

    refreshOLED(oledColOffset);

    delay(1200);

  }
}
